# App
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Auth method: jwt | keycloak (auto-detects keycloak when KEYCLOAK_URL is set)
NEXT_PUBLIC_AUTH_METHOD=keycloak

# Keycloak (OIDC — local)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=optima
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=react-web-client
NEXT_PUBLIC_KEYCLOAK_CALLBACK_URL=http://localhost:4000/pages/auth/login-redirect
# Optional legacy/server-only names
NEXT_KEYCLOAK_URL=http://localhost:8080
NEXT_REALM=optima
NEXT_CLIENT_ID=react-web-client
NEXT_REDIRECT_URL=http://localhost:4000/pages/auth/login-redirect
KEYCLOAK_CLIENT_SECRET=

# Auth (login, sign-up, session) — Minimal JWT API (when NEXT_PUBLIC_AUTH_METHOD=jwt)
NEXT_PUBLIC_SERVER_URL=https://api-dev-minimal-v700.pages.dev

# Business API (vendors, items, purchase requests, etc.)
NEXT_PUBLIC_API_URL=https://semantic-pox-fox.ngrok-free.dev
